<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boilingpoint.news.mapper.SourcePlatformMapper">
    <select id="selectEnabledPlatforms" resultType="com.boilingpoint.news.entity.SourcePlatformEntity">
        SELECT id, name, code, logo, status, sort, created_at, updated_at
        FROM source_platform
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
