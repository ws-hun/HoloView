<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boilingpoint.news.mapper.HotCategoryMapper">
    <select id="selectEnabledCategories" resultType="com.boilingpoint.news.entity.HotCategoryEntity">
        SELECT id, name, code, status, sort, created_at, updated_at
        FROM hot_category
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
